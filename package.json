{
  "name": "bootcamp-app",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "start": "node server/index.js"
  },
  "engines": {
    "node": "26.x"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "fsevents@2.3.3": true
  }
}
